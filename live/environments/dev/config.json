{
    "environment": "dev",
    "aws_region": "ap-south-1",
    "cluster_name": "arealis-zord-dev-eks",
    "eks_name_prefix": "Arealis zord dev eks",
    "eks_resource_prefix": "arealis-zord-dev-eks",
    "vpc_name_prefix": "Arealis zord dev vpc",
    "vpc_resource_prefix": "arealis-zord-dev-vpc",
    "node_group_name": "arealis-zord-dev-eks-node-group",
    "network": {
        "vpc_cidr": "10.2.0.0/16",
        "public1_cidr": "10.2.1.0/24",
        "public2_cidr": "10.2.2.0/24",
        "private1_cidr": "10.2.3.0/24",
        "private2_cidr": "10.2.4.0/24",
        "admin_cidrs": [
            "0.0.0.0/0"
        ],
        "enable_flow_logs": true,
        "flow_log_retention_days": 30
    },
    "dns": {
        "env_domain": "dev.zordnet.com",
        "ses_domain": "zordnet.com",
        "kong_alb_stack_tag": "zord-dev-alb",
        "argocd_alb_group": "zord-dev-alb"
    },
    "buckets": {
        "edge": "dev-zord-edge-ingress",
        "canonical": "dev-zord-intent-engine-canonical",
        "nir": "dev-zord-intent-engine-nir",
        "governance": "dev-zord-intent-engine-governance",
        "outcome": "dev-zord-outcome-engine-settlement-ingress",
        "evidence": "dev-zord-evidence-vault",
        "force_destroy": true
    },
    "rds": {
        "instance_class": "db.t3.small",
        "allocated_storage": 20,
        "multi_az": false,
        "engine_version": "16",
        "deletion_protection": false,
        "skip_final_snapshot": true
    },
    "cluster": {
        "version": "1.32",
        "manage_admin_access": true,
        "endpoint_public_access": true,
        "public_access_cidrs": [
            "0.0.0.0/0"
        ]
    },
    "platform": {
        "app_repo_url": "https://github.com/Arealis-network/Arealis-Zord-intent.git",
        "external_secrets_namespace": "external-secrets",
        "external_secrets_service_account": "external-secrets",
        "application_mode": "helm",
        "target_revision": "master",
        "values_environment": "dev",
        "application_name_suffix": "dev",
        "applications_auto_sync": false,
        "observability_auto_sync_on_apply": true
    },
    "ses": {
        "manage_domain_identity": false,
        "workload_namespace": "zord",
        "workload_service_account": "zord-app"
    },
    "edge": {
        "enabled": true,
        "subdomain": "api",
        "public_subdomains": [
            "api",
            "www",
            "kong-admin"
        ],
        "origin_subdomain": "origin-api",
        "waf_rate_limit": 2000,
        "kong_alb_domain_name": ""
    }
}